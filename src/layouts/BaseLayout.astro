---
import '../styles/global.css';
import nunito400 from '@fontsource/nunito/files/nunito-latin-400-normal.woff2?url';
import playfair700 from '@fontsource/playfair-display/files/playfair-display-latin-700-normal.woff2?url';
import SEO from '../components/SEO.astro';
import LocalBusinessSchema from '../components/LocalBusinessSchema.astro';
import Header from '../components/Header.astro';
import MobileMenu from '../components/MobileMenu.astro';
import StickyActionBar from '../components/StickyActionBar.astro';
import EnrollBand from '../components/EnrollBand.astro';
import Footer from '../components/Footer.astro';
import NoticeBanner from '../components/NoticeBanner.astro';
interface Props { title: string; description?: string; ogImage?: string; noindex?: boolean; enrollPrev?: string }
const { title, description, ogImage, noindex = false, enrollPrev = '#F8F3FB' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#413659" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href={nunito400} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={playfair700} as="font" type="font/woff2" crossorigin />
    <SEO title={title} description={description} ogImage={ogImage} noindex={noindex} />
    <LocalBusinessSchema />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a href="#main" class="skip-link sr-only z-[100] rounded-full bg-gym-purple px-5 py-3 font-bold text-white focus:not-sr-only focus:fixed focus:left-4 focus:top-4">Skip to main content</a>
    <NoticeBanner />
    <Header />
    <MobileMenu />
    <main id="main" tabindex="-1" class="outline-none">
      <slot />
    </main>
    <EnrollBand prev={enrollPrev} />
    <Footer />
    <StickyActionBar />
    <script>
      import '../scripts/site.ts';
    </script>
  </body>
</html>

---
import Icon from './Icon.astro';
import { site } from '../lib/site';
---
<div class="relative h-[320px] overflow-hidden rounded-[24px] bg-purple-50 ring-1 ring-purple-100 md:h-[420px]" data-map data-src={site.mapEmbed} data-title="Map to Stoughton Gymnastics, 201 W. Main Street">
  <div class="absolute inset-0 flex flex-col items-center justify-center gap-4 p-6 text-center" data-map-card>
    <svg class="absolute inset-0 h-full w-full opacity-60" aria-hidden="true"><defs><pattern id="grid" width="36" height="36" patternUnits="userSpaceOnUse"><path d="M36 0H0V36" fill="none" stroke="#E4DEF0" stroke-width="2"/></pattern></defs><rect width="100%" height="100%" fill="url(#grid)"/></svg>
    <span class="relative inline-flex h-16 w-16 items-center justify-center rounded-full bg-plum text-white shadow-lg"><Icon name="map-pin" size={30} /></span>
    <p class="relative font-extrabold text-gym-purple">201 W. Main Street<br />Stoughton, WI 53589</p>
    <div class="relative flex flex-wrap justify-center gap-3">
      <button type="button" class="btn btn-secondary btn-sm" data-map-load><Icon name="map" size={18} />Show map</button>
      <a href={site.directions} target="_blank" rel="noopener" class="btn btn-primary btn-sm"><Icon name="navigation" size={18} />Get directions<span class="sr-only">(opens in new tab)</span></a>
    </div>
    <p class="relative text-xs text-slate">The map loads from Google when you tap "Show map".</p>
  </div>
</div>

---
import { Picture } from 'astro:assets';
import { img, widthsFor } from '../lib/images';
interface Props { src: string; alt: string; sizes?: string; class?: string; pictureClass?: string; eager?: boolean; widths?: number[]; maxWidth?: number }
const { src, alt, sizes = '(min-width:1024px) 33vw, 100vw', class: cls = '', pictureClass = '', eager = false, widths, maxWidth } = Astro.props;
const meta = img(src);
let w = widthsFor(meta, widths);
if (maxWidth) w = w.filter((x) => x <= maxWidth).concat(Math.min(maxWidth, meta.width)).filter((v, i, a) => a.indexOf(v) === i);
const fallback = meta.format === 'png' ? 'png' : 'jpg';
---
<Picture
  src={meta}
  alt={alt}
  formats={['avif', 'webp']}
  fallbackFormat={fallback}
  widths={w}
  sizes={sizes}
  class={cls}
  pictureAttributes={{ class: pictureClass }}
  loading={eager ? 'eager' : 'lazy'}
  decoding={eager ? 'auto' : 'async'}
  fetchpriority={eager ? 'high' : undefined}
/>

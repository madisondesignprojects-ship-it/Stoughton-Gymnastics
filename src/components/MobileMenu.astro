---
import Icon from './Icon.astro';
import ConfettiDots from './ConfettiDots.astro';
import { nav, site, tel, isCurrent } from '../lib/site';
const path = Astro.url.pathname;
---
<div id="mobile-menu" class="fixed inset-0 z-[60] lg:hidden" hidden data-menu>
  <div class="absolute inset-0 bg-ink/50 opacity-0 transition-opacity duration-300" data-menu-backdrop></div>
  <div class="menu-panel absolute inset-y-0 right-0 flex w-full max-w-sm translate-x-full flex-col overflow-y-auto bg-gym-purple text-white transition-transform duration-300" role="dialog" aria-modal="true" aria-label="Site menu" data-menu-panel>
    <ConfettiDots class="absolute -right-4 top-14 opacity-80" variant="b" />
    <div class="relative flex h-16 items-center justify-between px-5">
      <span class="font-display text-xl font-bold">Menu</span>
      <button type="button" class="inline-flex h-12 w-12 items-center justify-center rounded-full bg-white/10 hover:bg-white/20" data-menu-close>
        <Icon name="x" size={24} /><span class="sr-only">Close menu</span>
      </button>
    </div>
    <nav aria-label="Mobile" class="relative px-3">
      <ul class="space-y-1">
        {nav.map((item, i) => (
          <li>
            <div class="flex items-stretch">
              <a href={item.href} target={item.external ? '_blank' : undefined} rel={item.external ? 'noopener' : undefined}
                 aria-current={isCurrent(item.href, path) ? 'page' : undefined}
                 class={`flex min-h-12 flex-1 items-center gap-2 rounded-2xl px-4 text-lg font-bold hover:bg-white/10 ${isCurrent(item.href, path) ? 'bg-white/10 underline decoration-teal decoration-[3px] underline-offset-8' : ''}`}>
                {item.label}{item.external && <><Icon name="external-link" size={16} class="opacity-70" /><span class="sr-only">(opens in new tab)</span></>}
              </a>
              {item.children && (
                <button type="button" class="ml-1 inline-flex min-h-12 w-12 items-center justify-center rounded-2xl hover:bg-white/10" aria-expanded="false" aria-controls={`mm-${i}`} data-acc-btn>
                  <Icon name="chevron-down" size={20} class="transition-transform duration-200" /><span class="sr-only">Show {item.label} pages</span>
                </button>
              )}
            </div>
            {item.children && (
              <ul id={`mm-${i}`} hidden class="mb-1 ml-4 border-l-2 border-white/20 pl-2">
                {item.children.map((c) => (
                  <li><a href={c.href} aria-current={isCurrent(c.href, path) ? 'page' : undefined} class="flex min-h-12 items-center rounded-2xl px-4 text-base font-semibold text-purple-100 hover:bg-white/10 hover:text-white">{c.label}</a></li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
    </nav>
    <div class="relative mt-auto space-y-3 px-5 pb-8 pt-6">
      <a href={site.iclassproClasses} target="_blank" rel="noopener" class="btn btn-on-dark w-full text-lg">Enroll <Icon name="external-link" size={18} /><span class="sr-only">(opens in new tab)</span></a>
      <div class="grid grid-cols-2 gap-3">
        <a href={site.iclassproRegister} target="_blank" rel="noopener" class="btn btn-outline-dark btn-sm">Create an Account<span class="sr-only">(opens in new tab)</span></a>
        <a href={site.iclassproPortal} target="_blank" rel="noopener" class="btn btn-outline-dark btn-sm">Member Login<span class="sr-only">(opens in new tab)</span></a>
      </div>
      <ul class="space-y-2 pt-3 text-[15px] text-purple-100">
        <li><a href={tel} class="flex min-h-11 items-center gap-3 hover:text-white"><Icon name="phone" size={20} />{site.phoneBranded}</a></li>
        <li><a href={`mailto:${site.email}`} class="flex min-h-11 items-center gap-3 hover:text-white"><Icon name="mail" size={20} class="shrink-0" /><span>information@<wbr />stoughtongymnastics.com</span></a></li>
        <li><a href={site.directions} target="_blank" rel="noopener" class="flex min-h-11 items-center gap-3 hover:text-white"><Icon name="map-pin" size={20} />{site.address.street}, {site.address.city}, {site.address.state} {site.address.zip}<span class="sr-only">(opens in new tab)</span></a></li>
      </ul>
      <div class="flex gap-3">
        <a href={site.facebook} target="_blank" rel="noopener" aria-label="Stoughton Gymnastics on Facebook (opens in new tab)" class="inline-flex h-12 w-12 items-center justify-center rounded-full bg-white/10 hover:bg-white/20"><Icon name="facebook" /></a>
        <a href={site.instagram} target="_blank" rel="noopener" aria-label="Stoughton Gymnastics on Instagram (opens in new tab)" class="inline-flex h-12 w-12 items-center justify-center rounded-full bg-white/10 hover:bg-white/20"><Icon name="instagram" /></a>
      </div>
    </div>
  </div>
</div>

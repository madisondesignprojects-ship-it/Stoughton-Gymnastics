---
// Visible "confirm with gym" marker (build script 7.14).
// Always rendered visibly in this pre-launch build; `npm run build:launch` fails while any remain.
interface Props { note: string; inline?: boolean; class?: string }
const { note, inline = false, class: cls = '' } = Astro.props;
---
{inline
  ? <span class={`placeholder-inline ${cls}`} data-placeholder>⚠ PLACEHOLDER - confirm with gym: {note}</span>
  : <div class={`placeholder-box ${cls}`} role="note" data-placeholder>⚠ PLACEHOLDER - confirm with gym: {note}</div>}

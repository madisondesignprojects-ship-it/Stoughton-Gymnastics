---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Img from '../components/Img.astro';
import Icon from '../components/Icon.astro';
import Gallery from '../components/Gallery.astro';
import InfoCard from '../components/InfoCard.astro';
import ConfettiDots from '../components/ConfettiDots.astro';
import Placeholder from '../components/Placeholder.astro';
import team from '../content/gallery-team.json';
import { tel, mailto } from '../lib/site';
const levels = [['Copper', '#B87333'], ['Bronze', '#CD7F32'], ['Silver', '#C0C0C0'], ['Gold', '#D4AF37'], ['Platinum', '#E5E4E2'], ['Diamond', '#B9F2FF']];
---
<BaseLayout title="XCEL Team Gymnastics | Stoughton Gymnastics" ogImage="/og/team.jpg"
  description="XCEL Gymnastics is offered! We currently compete in all 6 Xcel levels (Copper, Bronze, Silver, Gold, Platinum, Diamond) and also offer a Recreational Team.">
  <PageHero title="Gymnastics Team" subtitle="XCEL Gymnastics is offered!" crumbs={[{ label: 'Classes Offered', href: '/classes-offered' }, { label: 'Team Gymnastics' }]} />

  <section class="section pt-8">
    <div class="container-x grid items-center gap-12 lg:grid-cols-2">
      <div class="reveal prose-sg text-lg">
        <p>The Xcel program allows gymnasts to start competing with beginner/intermediate skills in entry levels, such as Copper and Bronze.</p>
        <p>There are 6 levels of Xcel: Copper, Bronze, Silver, Gold, Platinum, Diamond. We currently compete in all 6 levels and also offer a Recreational Team. Commitments range from 1-2 hours a week for entry levels/part-year and 4-6 hours a week/year-round for upper levels.</p>
      </div>
      <div class="relative mx-auto w-full max-w-[520px]">
        <ConfettiDots class="absolute -left-8 -top-10 z-10 w-36" />
        <div class="polaroid tilt-r w-full"><Img src="team-gymnastics/team-13-team-on-podium-2019-banner.jpg" alt="Team celebrating on the podium in front of a 2019 banner" sizes="(min-width:1024px) 500px, 92vw" class="w-full" /></div>
        <ConfettiDots class="absolute -bottom-8 -right-6 w-32" variant="b" />
      </div>
    </div>
  </section>

  <section class="bg-purple-50 py-16" aria-labelledby="levels-title">
    <div class="container-x">
      <h2 id="levels-title" class="reveal text-center">The 6 Xcel levels</h2>
      <ol class="mx-auto mt-10 grid max-w-4xl grid-cols-3 items-end gap-x-4 gap-y-8 md:grid-cols-6" data-stagger>
        {levels.map(([n, c], i) => (
          <li class="reveal flex flex-col items-center gap-3 text-center" style={`--d:${i * 60}ms`}>
            <span class="medal relative" style={`width:${56 + i * 6}px;height:${56 + i * 6}px;background: radial-gradient(circle at 30% 28%, #ffffffb0 0, transparent 42%), linear-gradient(135deg, ${c}, color-mix(in srgb, ${c} 55%, #000))`} aria-hidden="true">
              {n === 'Diamond' && <svg viewBox="0 0 20 20" class="absolute -right-1 -top-1 h-5 w-5" aria-hidden="true"><path d="M10 0 Q11.8 8.2 20 10 Q11.8 11.8 10 20 Q8.2 11.8 0 10 Q8.2 8.2 10 0Z" fill="#FFCB05"/></svg>}
            </span>
            <span class="font-extrabold text-ink">{n}</span>
          </li>
        ))}
      </ol>
      <div class="mx-auto mt-4 hidden max-w-4xl grid-cols-6 gap-x-4 md:grid" aria-hidden="true">
        <div class="col-span-2 border-x-2 border-b-2 border-teal/60 pb-1 pt-2 text-center text-sm font-extrabold text-teal-700">entry levels</div>
      </div>
      <p class="mt-6 text-center text-sm font-bold text-teal-700 md:hidden">Copper &amp; Bronze are entry levels</p>
    </div>
  </section>

  <section class="section" aria-labelledby="commit-title">
    <div class="container-x">
      <h2 id="commit-title" class="reveal">Commitment</h2>
      <div class="mt-8 grid gap-5 md:grid-cols-2" data-stagger>
        <InfoCard icon="clock" title="Entry levels / part-year">1-2 hours a week, entry levels/part-year</InfoCard>
        <InfoCard icon="trophy" title="Upper levels / year-round" tone="plum">4-6 hours a week, year-round for upper levels</InfoCard>
      </div>
      <p class="reveal mt-6 rounded-2xl bg-ice p-5 font-semibold text-gym-purple">XCEL gymnasts practice 2 days per week with practice times ranging from 75-120 minutes depending on XCEL level.</p>
    </div>
  </section>

  <section class="pb-16" aria-labelledby="team-photos">
    <div class="container-x">
      <h2 id="team-photos" class="reveal">Team Photos</h2>
      <Placeholder note="optional captions (meet names/years) for the team photos" />
      <div class="mt-6"><Gallery photos={team} label="Team photos" /></div>
    </div>
  </section>

  <section class="container-x pb-20" aria-labelledby="interested">
    <div class="reveal flex flex-col items-center gap-5 rounded-[32px] bg-plum-50 p-8 text-center md:flex-row md:justify-between md:p-10 md:text-left">
      <h2 id="interested" class="text-3xl md:text-4xl">Interested in team?</h2>
      <div class="flex flex-col gap-3 sm:flex-row">
        <a href={tel} class="btn btn-primary"><Icon name="phone" size={20} />Call (608) 88 VAULT</a>
        <a href={mailto('Team Gymnastics')} class="btn btn-secondary"><Icon name="mail" size={20} />Email us</a>
      </div>
    </div>
  </section>
</BaseLayout>
